# Copy to .env.local (never commit it). On Vercel, set these in Project → Settings → Environment Variables.
# None of these may use the NEXT_PUBLIC_ prefix.

# "sheets" | "mock". Defaults to sheets when SHEET_ID is set, else mock.
DATA_SOURCE=

# Google service account (read-only access to the sheet)
GOOGLE_SA_EMAIL=
# Paste the private key on one line with literal \n for newlines, wrapped in double quotes.
GOOGLE_SA_PRIVATE_KEY=
SHEET_ID=
